# Copy to .env and fill in. .env is gitignored and must never be committed.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# CORS — the frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DB_NAME=billing
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# JWT — kept separate from DJANGO_SECRET_KEY so rotating one does not sign out
# every user, and a leak of one does not compromise the other.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
